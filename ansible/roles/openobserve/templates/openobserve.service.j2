[Unit]
Description=OpenObserve observability backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/lib/openobserve
# ZO_ROOT_USER_EMAIL and ZO_ROOT_USER_PASSWORD come from this file, which
# autognosys-boot.sh writes from GCP Secret Manager at boot.
EnvironmentFile=/etc/openobserve/openobserve.env
Environment=ZO_DATA_DIR=/var/lib/openobserve
ExecStart=/usr/local/bin/openobserve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
